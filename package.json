{
  "name": "project",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --proxy 5173 --port 8788",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "db:migrate": "node scripts/check-deploy.mjs && wrangler d1 migrations apply dongjiayun-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply dongjiayun-db --local",
    "dev:full": "npm run build && wrangler pages dev dist --port 8788",
    "db:backup": "node scripts/backup.mjs",
    "predeploy": "node scripts/check-deploy.mjs && npm run build",
    "deploy": "wrangler pages deploy dist --project-name dongjiayun",
    "test": "node --test tests/*.test.mjs",
    "pretest": "npm run build",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "react": "~19.2.4",
    "react-dom": "~19.2.4",
    "react-router-dom": "^7.13.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.58.2",
    "vite": "^7.3.1",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
